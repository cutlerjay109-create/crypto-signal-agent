# Solana Wallet
SOLANA_PRIVATE_KEY=your_base58_private_key
SOLANA_PUBLIC_KEY=your_wallet_public_key

# Synapse RPC
SYNAPSE_RPC_URL=https://us-1-mainnet.oobeprotocol.ai/rpc?api_key=YOUR_KEY
SYNAPSE_API_KEY=your_synapse_api_key

# Ace Data Cloud API Keys
ACEDATA_API_KEY=your_general_api_key
ACEDATA_SERP_KEY=your_serp_api_key
ACEDATA_GEMINI_KEY=your_gemini_api_key
ACEDATA_CLAUDE_KEY=your_claude_api_key

# Agent Settings
AGENT_NAME=CryptoSignalAgent
SCHEDULE_INTERVAL=360

# Payment Mode
# true  = use API credits (testing/free)
# false = use real USDC via x402 (production)
X402_TEST_MODE=true
